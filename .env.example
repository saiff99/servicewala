# ─────────────────────────────────────────────────────────────
# Servicewala Environment Variables Template
# Copy this file to .env or .env.local when setting up Phase 2
# ─────────────────────────────────────────────────────────────

# Application
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_NAME="Servicewala"

# Backend & Database (Supabase)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Payment Gateway (Razorpay)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Google Maps / Location Services (Optional)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

